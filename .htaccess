RewriteEngine On
# Sesuaikan RewriteBase dengan subfolder saat deploy. Contoh local: /rekrutmen/
RewriteBase /rekrutmen/

# Jika file/folder tidak ditemukan, teruskan ke index.php (front controller)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
